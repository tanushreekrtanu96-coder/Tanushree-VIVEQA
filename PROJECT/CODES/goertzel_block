module goertzel_block #(
    parameter signed [15:0] COEFF = 16'sd0,  // 2*cos(2*pi*k/N), Q2.13 fixed-point
    parameter integer N = 205                // block length (samples)
)(
    input  wire clk,
    input  wire rst,
    input  wire tick,                        // sample tick (8 kHz)
    input  wire signed [7:0] sample_in,
    output reg  block_done = 0,
    output reg  signed [39:0] mag = 0
);
    reg signed [31:0] Q1 = 0, Q2 = 0;
    reg [9:0] count = 0;

    wire signed [47:0] prod       = COEFF * Q1;
    wire signed [31:0] prod_shift = prod >>> 13;
    wire signed [32:0] Q0         = $signed({{25{sample_in[7]}}, sample_in}) + prod_shift - Q2;

    // final-magnitude terms (computed continuously; only latched at block end)
    wire signed [63:0] term1 = Q1 * Q1;
    wire signed [63:0] term2 = Q2 * Q2;
    wire signed [63:0] term3 = prod_shift * Q2;
    wire signed [63:0] mag_full = term1 + term2 - term3;

    always @(posedge clk) begin
        if (rst) begin
            Q1 <= 0; Q2 <= 0; count <= 0; block_done <= 0; mag <= 0;
        end else begin
            block_done <= 0;
            if (tick) begin
                Q2 <= Q1;
                Q1 <= Q0[31:0];
                if (count == N-1) begin
                    count      <= 0;
                    mag        <= mag_full[63:24]; // scaled-down magnitude for comparison
                    block_done <= 1;
                    Q1 <= 0;
                    Q2 <= 0;
                end else begin
                    count <= count + 1;
                end
            end
        end
    end
endmodule
