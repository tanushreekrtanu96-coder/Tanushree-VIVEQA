module dtmf_top #(
    parameter integer CLK_FREQ_HZ = 100_000_000
)(
    input  wire clk,
    input  wire rst,
    input  wire [3:0] sw,
    input  wire btn_send,
    output wire pwm_audio_l,
    output wire pwm_audio_r,
    output wire [6:0] seg,
    output wire [3:0] an,
    output wire led_valid
);
    wire tick;
    sample_clk_gen #(.CLK_FREQ_HZ(CLK_FREQ_HZ), .SAMPLE_HZ(8000)) u_sclk (
        .clk(clk), .rst(rst), .tick(tick)
    );

    wire signed [7:0] audio_sample;
    dtmf_tx u_tx (
        .clk(clk), .rst(rst), .tick(tick),
        .key(sw), .key_valid(btn_send),
        .audio_sample(audio_sample)
    );

    wire pwm_out;
    pwm_dac u_dac (.clk(clk), .sample(audio_sample), .pwm_out(pwm_out));

    assign pwm_audio_l = pwm_out;
    assign pwm_audio_r = pwm_out;

    wire [3:0] decoded_key;
    wire decoded_valid;
    dtmf_rx u_rx (
        .clk(clk), .rst(rst), .tick(tick),
        .sample_in(audio_sample),
        .decoded_key(decoded_key), .decoded_valid(decoded_valid)
    );

    reg [3:0] display_key = 0;
    reg valid_latch = 0;
    always @(posedge clk) begin
        if (rst) begin
            display_key <= 0; valid_latch <= 0;
        end else if (decoded_valid) begin
            display_key <= decoded_key;
            valid_latch <= btn_send;
        end
    end

    seven_seg_hex u_disp (.key(display_key), .seg(seg));
    assign led_valid = valid_latch;

    // enable only digit 0, keep digits 1-3 blank (active-low anode assumed)
    assign an = 4'b1110;

endmodule
