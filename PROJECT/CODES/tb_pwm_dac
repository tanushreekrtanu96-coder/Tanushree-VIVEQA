`timescale 1ns/1ps
module tb_pwm_dac;
    reg clk = 0;
    reg signed [7:0] sample;
    wire pwm_out;

    pwm_dac dut (.clk(clk), .sample(sample), .pwm_out(pwm_out));

    always #5 clk = ~clk;
    integer errors = 0;

    task check_duty(input signed [7:0] s, input integer expected_high_cycles);
        integer i, high_count;
        begin
            sample = s;
            high_count = 0;
            for (i = 0; i < 256; i = i + 1) begin
                @(posedge clk);
                if (pwm_out) high_count = high_count + 1;
            end
            // allow +-2 cycle tolerance for boundary rounding
            if (high_count < expected_high_cycles - 2 || high_count > expected_high_cycles + 2) begin
                $display("FAIL: sample=%0d expected ~%0d high cycles, got %0d",
                          s, expected_high_cycles, high_count);
                errors = errors + 1;
            end else begin
                $display("PASS: sample=%0d -> %0d/256 high cycles (expected ~%0d)",
                          s, high_count, expected_high_cycles);
            end
        end
    endtask

    initial begin
        check_duty(-128, 0);    // duty = 0 -> always low
        check_duty(0, 128);     // duty = 128 -> ~50%
        check_duty(127, 255);   // duty = 255 -> almost always high

        if (errors == 0) $display("=== PASS: pwm_dac all checks passed ===");
        else $display("=== FAIL: %0d errors ===", errors);
        $finish;
    end
endmodule
