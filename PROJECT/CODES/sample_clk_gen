module sample_clk_gen #(
    parameter integer CLK_FREQ_HZ = 100_000_000,
    parameter integer SAMPLE_HZ   = 8000
)(
    input  wire clk,
    input  wire rst,
    output reg  tick = 0
);
    localparam integer DIVIDER = CLK_FREQ_HZ / SAMPLE_HZ;
    reg [$clog2(DIVIDER)-1:0] cnt = 0;

    always @(posedge clk) begin
        if (rst) begin
            cnt <= 0; tick <= 0;
        end else if (cnt == DIVIDER-1) begin
            cnt <= 0; tick <= 1;
        end else begin
            cnt <= cnt + 1; tick <= 0;
        end
    end
endmodule
