`timescale 1ns/1ps
module tb_sample_clk_gen;
    localparam CLK_FREQ_HZ = 1_000_000; // 1MHz for fast sim -> divider = 125
    reg clk = 0, rst = 1;
    wire tick;

    sample_clk_gen #(.CLK_FREQ_HZ(CLK_FREQ_HZ), .SAMPLE_HZ(8000)) dut (
        .clk(clk), .rst(rst), .tick(tick)
    );

    always #500 clk = ~clk; // 1MHz

    integer tick_count = 0;
    integer cycle_count = 0;
    integer errors = 0;

    always @(posedge clk) begin
        cycle_count = cycle_count + 1;
        if (tick) tick_count = tick_count + 1;
    end

    initial begin
        rst = 1; repeat (5) @(posedge clk); rst = 0;

        // 125 cycles/tick expected; run 1250 cycles -> expect ~10 ticks
        repeat (1250) @(posedge clk);

        if (tick_count < 9 || tick_count > 11) begin
            $display("FAIL: expected ~10 ticks in 1250 cycles, got %0d", tick_count);
            errors = errors + 1;
        end else begin
            $display("PASS: sample_clk_gen produced %0d ticks (expected ~10)", tick_count);
        end

        if (errors == 0) $display("PASS: sample_clk_gen all checks passed");
        $finish;
    end
endmodule
